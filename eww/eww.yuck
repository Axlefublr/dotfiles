(defwindow sounding [side orientation]
	:monitor '0'
	:geometry (geometry
		:width  { orientation == 'hor'  ? '22px' : '80px' }
		:height { orientation == 'vert' ? '22px' : '80px' }
		:anchor 'bottom ${side}'
	)
	:stacking 'overlay'
	:focusable 'none'
	:exclusive false
	:namespace 'eww'
	(box :class 'fill-line')
)
