component Modifier (text, index) {
	Window self.id {
		namespace = 'eww'
		stacking = 'overlay'
		passinput = true
		geometry = {
			anchor = 'bottom left'
			x = (22 + 60 * index - 4 * index).to_string() + 'px'
			y = '22px'
		}
		Box {
			class = 'modifier'
			Label {
				class = 'monospace ' + self.id
				text = text
			}
		}
	}
}

Modifier 'meta' {
	text = '#'
	index = 0
}

Modifier 'ctrl' {
	text = '^'
	index = 1
}

Modifier 'shift' {
	text = '+'
	index = 2
}

Modifier 'alt' {
	text = '!'
	index = 3
}
