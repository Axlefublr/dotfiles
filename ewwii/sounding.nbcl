component Sounding (vert, hor) {
	Window self.id {
		namespace = 'eww'
		stacking = 'overlay'
		passinput = true
		geometry = {
			anchor = vert + ' ' + hor
		}
		Box {
			class = 'sounding ' + vert + ' ' + hor
		}
	}
}

Sounding 'sounding1' {
	vert = 'bottom'
	hor = 'left'
}

Sounding 'sounding2' {
	vert = 'bottom'
	hor = 'right'
}

