(deftemplate bookmark-open (which)
	(multi (cmd fish -c (concat "bookmark_open " $which)) (layer-switch default))
)

(deftemplate bookmark-set (which)
	(multi (cmd fish -c (concat "bookmark_set " $which r#" "$(wl-paste -n -t text/plain)""#)) (layer-switch default))
)

(deflayermap (bookmark)
	___ @layer-unswitch
	a (t! bookmark-open a)
	b (t! bookmark-open b)
	c (t! bookmark-open c)
	s (tap-hold-release $tt $ht (t! bookmark-open s) (layer-toggle bookmark-shifted))
	e (t! bookmark-open e)
	f (t! bookmark-open f)
	g (t! bookmark-open g)
	h (t! bookmark-open h)
	i (t! bookmark-open i)
	j (t! bookmark-open j)
	l (tap-hold-release $tt $ht (t! bookmark-open l) (layer-toggle bookmark-shifted))
	k (t! bookmark-open k)
	m (t! bookmark-open m)
	n (t! bookmark-open n)
	o (t! bookmark-open o)
	p (t! bookmark-open p)
	q (t! bookmark-open q)
	r (t! bookmark-open r)
	d (t! bookmark-open d)
	t (t! bookmark-open t)
	u (t! bookmark-open u)
	v (t! bookmark-open v)
	w (t! bookmark-open w)
	x (t! bookmark-open x)
	y (t! bookmark-open y)
	z (t! bookmark-open z)
	[ (t! bookmark-open leftbrace)
	] (t! bookmark-open rightbrace)
	; (t! bookmark-open semicolon)
	' (t! bookmark-open apostrophe)
	, (t! bookmark-open comma)
	. (t! bookmark-open period)
	/ (t! bookmark-open slash)
)

(deflayermap (bookmark-shifted)
	___ @layer-unswitch
	a (t! bookmark-open A)
	b (t! bookmark-open B)
	c (t! bookmark-open C)
	d (t! bookmark-open D)
	e (t! bookmark-open E)
	f (t! bookmark-open F)
	g (t! bookmark-open G)
	h (t! bookmark-open H)
	i (t! bookmark-open I)
	j (t! bookmark-open J)
	k (t! bookmark-open K)
	l (t! bookmark-open L)
	m (t! bookmark-open M)
	n (t! bookmark-open N)
	o (t! bookmark-open O)
	p (t! bookmark-open P)
	q (t! bookmark-open Q)
	r (t! bookmark-open R)
	s (t! bookmark-open S)
	t (t! bookmark-open T)
	u (t! bookmark-open U)
	v (t! bookmark-open V)
	w (t! bookmark-open W)
	x (t! bookmark-open X)
	y (t! bookmark-open Y)
	z (t! bookmark-open Z)
	[ (t! bookmark-open leftcurl)
	] (t! bookmark-open rightcurl)
	; (t! bookmark-open colon)
	' (t! bookmark-open doublequote)
	, (t! bookmark-open leftpointy)
	. (t! bookmark-open rightpointy)
	/ (t! bookmark-open question)
)

