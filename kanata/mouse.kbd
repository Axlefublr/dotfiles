(deflayermap (space)
	caps (tap-hold-release $tt $ht esc (multi (layer-toggle caps) (layer-toggle caps-space) (on↑ tap-vkey caps)))
	' (multi (layer-toggle quote) (layer-toggle space-quote) (on↑ tap-vkey quote))
	spc (cmd ydotool mousemove -a 533 300)
	n (on↓ toggle-vkey mouse-mode)
	l (multi (layer-toggle mouse-slow) (on↑ tap-vkey l))
	;; l (movemouse-speed 1)

	k (on↓ press-vkey neru-first)
	y XX
	z XX
	c y

	u (cmd niri msg action set-zoom-level +1)
	p (tap-hold-release $tt $ht (cmd niri msg action set-zoom-level -- -1) (cmd niri msg action set-zoom-level 1))
	v (tap-hold-release $tt $ht C-w XX)
	; (multi (cmd fish -c screenshot_select) (on↑ tap-vkey modifier))
	x (cmd fish -c r#"show_clipboard_image -F -e "swayimg.viewer.set_default_scale('fill')""#)

	a (on↓ press-vkey shift)
	q (on↓ press-vkey meta)
	t (on↓ press-vkey alt)
	g (on↓ press-vkey ctrl)

	m (multi mmid (on↑ tap-vkey modifier))
	j (multi mlft (on↑ tap-vkey modifier))
	h (multi mrgt (on↑ tap-vkey modifier))
	, pgup
	. pgdn

	o (mwheel-up    30 60)
	i (mwheel-down  30 60)
	w (mwheel-left  20 60)
	r (mwheel-right 20 60)

	s (movemouse-accel-left  5 210 1 8)
	d (movemouse-accel-down  5 210 1 8)
	e (movemouse-accel-up    5 210 1 8)
	f (movemouse-accel-right 5 210 1 8)
)

(deflayermap (mouse-slow)
	s (movemouse-left  12 1)
	d (movemouse-down  12 1)
	e (movemouse-up    12 1)
	f (movemouse-right 12 1)
)

(deflayermap (space-quote)
	c (cmd fish -c clipboard_image_save)
	e (cmd fish -c fragmentize_url)
	s (multi (cmd fish -c annotate_screen) (on↑ tap-vkey modifier-zoom))
	w (cmd fish -c mouse_position)
	d C-S-s
	x C-A-b
	z C-A-y
)

(deflayermap (caps-space)
	i C-S-c
	o C-S-i
	k (cmd fish -c pick_and_copy_color)
)

(deflayermap (neru-first)
	k (cmd neru action reset)
	w (multi (cmd neru action feed --mode w) (on↓ press-vkey neru-second))
	e (multi (cmd neru action feed --mode e) (on↓ press-vkey neru-second))
	r (multi (cmd neru action feed --mode r) (on↓ press-vkey neru-second))
	s (multi (cmd neru action feed --mode s) (on↓ press-vkey neru-second))
	d (multi (cmd neru action feed --mode d) (on↓ press-vkey neru-second))
	f (multi (cmd neru action feed --mode f) (on↓ press-vkey neru-second))
	x (multi (cmd neru action feed --mode x) (on↓ press-vkey neru-second))
	c (multi (cmd neru action feed --mode c) (on↓ press-vkey neru-second))
	v (multi (cmd neru action feed --mode v) (on↓ press-vkey neru-second))
)

(deflayermap (neru-second)
	k (multi (cmd neru action reset) (release-layer neru-second))
	w (multi (cmd neru action feed --mode w) (on↓ release-vkey neru-second))
	e (multi (cmd neru action feed --mode e) (on↓ release-vkey neru-second))
	r (multi (cmd neru action feed --mode r) (on↓ release-vkey neru-second))
	s (multi (cmd neru action feed --mode s) (on↓ release-vkey neru-second))
	d (multi (cmd neru action feed --mode d) (on↓ release-vkey neru-second))
	f (multi (cmd neru action feed --mode f) (on↓ release-vkey neru-second))
	x (multi (cmd neru action feed --mode x) (on↓ release-vkey neru-second))
	c (multi (cmd neru action feed --mode c) (on↓ release-vkey neru-second))
	v (multi (cmd neru action feed --mode v) (on↓ release-vkey neru-second))
)
