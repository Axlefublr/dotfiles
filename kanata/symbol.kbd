(deflayermap (x)
	c (multi (layer-toggle c) (layer-toggle cx) (on↑ tap-vkey c))
	v (multi (layer-toggle v) (layer-toggle vx) (on↑ tap-vkey v))
	;; [[sort on]]
	, S-1
	. (t! repeat (cmd wtype …))
	/ bksl
	; (cmd fish -c "wtype (date +%y.%m.%d)")
	h S-4
	i S-8
	j S-eql
	k min
	l eql
	m S-5
	n (t! repeat (cmd wtype ×))
	o S-3
	p (t! repeat (cmd wtype √))
	u (t! repeat (cmd wtype ÷))
	;; [[sort off]]
)

(deflayermap (c)
	v (multi (layer-toggle v) (layer-toggle cv) (on↑ tap-vkey v))
	x (multi (layer-toggle x) (layer-toggle cx) (on↑ tap-vkey x))
	;; [[sort on]]
	, S-7
	. (t! repeat (cmd wtype °))
	/ S-bksl
	; (cmd fish -c "wtype (uclanr)")
	h (t! repeat (cmd wtype €))
	i S-6
	j grv
	k S-min
	l (t! repeat (cmd wtype —))
	m S-grv
	n (t! repeat (cmd wtype ¢))
	o S-2
	p (t! repeat (cmd wtype ™))
	u (t! repeat (cmd wtype ₽))
	;; [[sort off]]
)

(deflayermap (cx)
	m (t! repeat (cmd wtype ≻))
	n (t! repeat (cmd wtype ≺))
	j (t! repeat (cmd wtype ≤))
	k (t! repeat (cmd wtype ≥))
	l (t! repeat (cmd wtype ≈))
	. (t! repeat (cmd wtype ⤓))
	, (t! repeat (cmd wtype ⤒))
	; (t! repeat (cmd wtype ␈))
	' (t! repeat (cmd wtype ␡))
	i (t! repeat (cmd wtype ⊼))
	o (t! repeat (cmd wtype ⊻))
	/ (t! repeat (cmd wtype ‽))
	spc (t! repeat (cmd wtype ␣))
)

(deflayermap (v)
	c (multi (layer-toggle c) (layer-toggle cv) (on↑ tap-vkey c))
	x (multi (layer-toggle x) (layer-toggle vx) (on↑ tap-vkey x))
	;; [[sort on]]
	' (t! repeat (cmd wtype ■))
	, (t! repeat (cmd wtype ❗))
	. (t! repeat (cmd wtype ⚠️))
	/ (t! repeat (cmd wtype ❓))
	; (t! repeat (cmd wtype █))
	b (t! repeat (cmd wtype 💡))
	h (t! repeat (cmd wtype ←))
	i (t! repeat (cmd wtype ✨))
	j (t! repeat (cmd wtype ↓))
	k (t! repeat (cmd wtype ↑))
	l (t! repeat (cmd wtype →))
	m (t! repeat (cmd wtype ✅))
	n (t! repeat (cmd wtype ❌))
	o (t! repeat (cmd wtype ¬))
	u (t! repeat (cmd wtype ∞))
	;; [[sort off]]
)

(deflayermap (cv)
	, (t! repeat (cmd wtype ‼️))
	/ (t! repeat (cmd wtype ⁉️))
)

(deflayermap (vx)
	; (cmd fish -c "(t! repeat wtype (date +%Y-%m-%d))")
	, (t! repeat (cmd wtype ¡))
	/ (t! repeat (cmd wtype ¿))
)

(deflayermap (u)
	i (multi (layer-toggle i) (layer-toggle iu) (on↑ tap-vkey i))
	;; [[sort on]]
	a (t! repeat (cmd wtype 😇))
	c (t! repeat (cmd wtype 😢))
	d (t! repeat (cmd wtype 😈))
	e (t! repeat (cmd wtype 🗣️))
	f (t! repeat (cmd wtype 🔥))
	g (t! repeat (cmd wtype 😎))
	r (t! repeat (cmd wtype 🚀))
	s (t! repeat (cmd wtype 😔))
	t (t! repeat (cmd wtype 🤔))
	w (t! repeat (cmd wtype ✍️))
	x (t! repeat (cmd wtype 🤯))
	z (t! repeat (cmd wtype 💯))
	;; [[sort off]]
)

(deflayermap (iu)
	c (t! repeat (cmd wtype 💗))
	e (t! repeat (cmd wtype 👀))
	r (t! repeat (cmd wtype 🙄))
	s (t! repeat (cmd wtype 💀))
	w (t! repeat (cmd wtype 😩))
	a (t! repeat (cmd wtype 🙏))
)

(deflayermap (r)
	w (multi lmet (layer-toggle w) (layer-toggle rw) (on↑ tap-vkey w))
	e (multi (layer-toggle e) (layer-toggle er) (on↑ tap-vkey e))
	;; [[sort on]]
	, (t! repeat (cmd wtype 🕯️))
	i (t! repeat (cmd wtype 😌))
	k (t! repeat (cmd wtype 😼))
	l (t! repeat (cmd wtype 🤤))
	m (t! repeat (cmd wtype 🧐))
	n (t! repeat (cmd wtype 🥺))
	o (t! repeat (cmd wtype 😭))
	p (t! repeat (cmd wtype 👏))
	u (t! repeat (cmd wtype 😋))
	y (t! repeat (cmd wtype 🥳))
	;; [[sort off]]
)

(deflayermap (er)
	w (multi lmet (layer-toggle w) (layer-toggle ew) (layer-toggle rw) (layer-toggle erw) (on↑ tap-vkey w))
	h (t! repeat (cmd wtype 🥰))
	p (t! repeat (cmd wtype 😤))
	n (t! repeat (cmd wtype 🥹))
	k (unmod lalt f11)
	j (unmod lalt f12)
)

(deflayermap (i)
	j (multi (layer-toggle j) (layer-toggle ij) (on↑ tap-vkey j))
	o (multi rmet (layer-toggle o) (layer-toggle io) (on↑ tap-vkey o))
	u (multi (layer-toggle u) (layer-toggle iu) (on↑ tap-vkey u))
	;; [[sort on]]
	a (t! repeat (cmd wtype “))
	c ]
	caps (t! repeat (cmd wtype 󰟢))
	d S-0
	e S-]
	f (t! repeat (cmd wtype ”))
	g (t! repeat (cmd wtype „))
	q (t! repeat (cmd wtype ‘))
	r (t! repeat (cmd wtype ’))
	s S-9
	v (t! repeat (cmd wtype »))
	w S-[
	x [
	z (t! repeat (cmd wtype «))
	;; [[sort off]]
)

(deflayermap (ij)
	o (multi rmet (layer-toggle o) (layer-toggle io) (layer-toggle jo) (layer-toggle ijo) (on↑ tap-vkey o))
	f (t! repeat (cmd wtype ¹))
	d (t! repeat (cmd wtype ²))
	s (t! repeat (cmd wtype ³))
	r (t! repeat (cmd wtype ⁴))
	e (t! repeat (cmd wtype ⁵))
	w (t! repeat (cmd wtype ⁶))
	v (t! repeat (cmd wtype ⁷))
	c (t! repeat (cmd wtype ⁸))
	x (t! repeat (cmd wtype ⁹))
	a (t! repeat (cmd wtype ⁰))
	z (t! repeat (cmd wtype ⁻))
	q (t! repeat (cmd wtype ⁺))
)

(deflayermap (jo)
	i (multi (layer-toggle i) (layer-toggle io) (layer-toggle ij) (layer-toggle ijo) (on↑ tap-vkey i))
	f (t! repeat (cmd wtype ₁))
	d (t! repeat (cmd wtype ₂))
	s (t! repeat (cmd wtype ₃))
	r (t! repeat (cmd wtype ₄))
	e (t! repeat (cmd wtype ₅))
	w (t! repeat (cmd wtype ₆))
	v (t! repeat (cmd wtype ₇))
	c (t! repeat (cmd wtype ₈))
	x (t! repeat (cmd wtype ₉))
	a (t! repeat (cmd wtype ₀))
	z (t! repeat (cmd wtype ₋))
	q (t! repeat (cmd wtype ₊))
)

(deflayermap (.)
	j (multi (layer-toggle j) (layer-toggle .j) (on↑ tap-vkey j))
	s (t! repeat (cmd wtype ┣))
	e (t! repeat (cmd wtype ┳))
	f (t! repeat (cmd wtype ┫))
	c (t! repeat (cmd wtype ┻))
	a (t! repeat (cmd wtype ┃))
	w (t! repeat (cmd wtype ┏))
	d (t! repeat (cmd wtype ━))
	r (t! repeat (cmd wtype ┓))
	x (t! repeat (cmd wtype ┗))
	v (t! repeat (cmd wtype ┛))
	g (t! repeat (cmd wtype ╋))
)

(deflayermap (.j)
	f (t! repeat (cmd wtype ①))
	d (t! repeat (cmd wtype ②))
	s (t! repeat (cmd wtype ③))
	r (t! repeat (cmd wtype ④))
	e (t! repeat (cmd wtype ⑤))
	w (t! repeat (cmd wtype ⑥))
	v (t! repeat (cmd wtype ⑦))
	c (t! repeat (cmd wtype ⑧))
	x (t! repeat (cmd wtype ⑨))
	a (t! repeat (cmd wtype ⓪))
)
