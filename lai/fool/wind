#!/usr/bin/env -S fish -N

set -l script_name (status filename | path basename)
set -l extra_flags
string match -qe sand -- "$script_name" && set -a extra_flags -H
if test "$argv[1]" = '»'
    set -f consume right
    set argv $argv[2..]
else if test "$argv[1]" = '«'
    set -f consume left
    set argv $argv[2..]
end
set -l shell
if test "$argv[1]" = '€'
    set argv $argv[2..]
    set shell nu --no-std-lib -n -c
else
    set shell fish -c
end
footclient -T helix-overlay -N $extra_flags -- $shell "$argv"
set -l last_char (string sub -s -1 -- "$script_name")
set -q consume && niri msg action consume-or-expel-window-left
if test "$consume" = left
    for i in (seq 1 10)
        niri msg action move-window-up
    end
    # niri msg action focus-window-down
end
